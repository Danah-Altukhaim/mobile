{
  "expo": {
    "name": "Masari",
    "slug": "masari",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1B4D3E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masari.app",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B4D3E"
      },
      "package": "com.masari.app",
      "supportsRTL": true
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "apiBaseUrl": "http://localhost:3000"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
